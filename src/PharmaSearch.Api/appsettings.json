{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "IndexName": "products"
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "catalog",
    "Collection": "products",
    "MaxConnectionPoolSize": 256
  }
}
